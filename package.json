    "express": "^5.3.0",
    "finalhandler": "2.1.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "xml2js": "0.6.2",
    "tc-core-library-js": "https://codeload.github.com/topcoder-platform/tc-core-library-js/tar.gz/c2df92b2227089909ab6e229df0ec6b658bb431a"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/finalhandler": "1.2.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/xml2js": "0.4.14",
